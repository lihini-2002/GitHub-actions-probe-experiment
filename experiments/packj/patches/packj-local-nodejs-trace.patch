diff --git a/packj/audit/pm_proxy/local_nodejs.py b/packj/audit/pm_proxy/local_nodejs.py
index 4533e9b..7bf266b 100644
--- a/packj/audit/pm_proxy/local_nodejs.py
+++ b/packj/audit/pm_proxy/local_nodejs.py
@@ -33,7 +33,24 @@ class LocalNodeJSProxy(PackageManagerProxy):
 	def get_downloads(self, pkg_name, pkg_info):
 		return None
 
+	def _is_tarball(self, pkg_name):
+		return os.path.isfile(pkg_name) and pkg_name.endswith('.tgz')
+
+	def _read_tarball_member(self, pkg_name, member):
+		# Experiment patch: npm tarballs keep files under package/
+		import tarfile
+		with tarfile.open(pkg_name, 'r:gz') as tar:
+			return tar.extractfile(f'package/{member}').read().decode('utf-8')
+
 	def get_metadata(self, pkg_name, pkg_version=None):
+		if self._is_tarball(pkg_name):
+			try:
+				pkg_info = json.loads(self._read_tarball_member(pkg_name, 'package.json'))
+			except Exception as e:
+				logging.debug("fail in get_metadata for tarball %s: %s", pkg_name, str(e))
+				pkg_info = None
+			return pkg_name, pkg_info
+
 		# local package, get metadata from package.json
 		pkg_json_path = os.path.join(pkg_name, 'package.json')
 		assert os.path.isdir(pkg_name) and os.path.isfile(pkg_json_path), 'invalid package path or package.json is not found'
