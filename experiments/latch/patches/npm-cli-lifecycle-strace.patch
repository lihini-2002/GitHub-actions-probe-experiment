+// LATCH: reconstructed from tools/latch/readme.md and the strace layout that
+// tools/latch/analyzer/analyzer.js reads. The upstream modified file was not
+// published, so this is a reproduction, not the authors' original code.
+//
+// Each lifecycle script runs as `strace -ff -ttt -yy -o <prefix> sh -c <cmd>`.
+// -ff -o writes one file per process, named <prefix>.<pid>; the analyzer takes
+// the pid from that suffix. -ttt gives the epoch timestamps the b3 grammar
+// parses and the analyzer orders syscalls by. -yy decodes fds to paths and
+// sockets, which the syscall analyzer reads from fd arguments and results.
+const LATCH_STRACE = '/usr/bin/strace'
+const LATCH_STRACE_DIR = '/straces'
+const LATCH_SCRIPT_TIMEOUT_MS = 10 * 60 * 1000
+
+function createExec (pkg, stage, sh, args) {
+  const name = pkg._id.replace(/\//g, '~')
+  const dir = path.join(LATCH_STRACE_DIR, name)
+  const prefix = path.join(dir, name + '_' + stage)
+  fs.mkdirSync(dir, { recursive: true })
+  return {
+    prefix: prefix,
+    cmd: LATCH_STRACE,
+    args: ['-ff', '-ttt', '-yy', '-o', prefix, sh].concat(args),
+    // The analyzer reads <prefix>_finished as "successful" and
+    // <prefix>_killed as "timedOut".
+    finish: function (code, signal, timedOut) {
+      fs.writeFileSync(prefix + '_exit', 'code=' + code + ' signal=' + signal + '\n')
+      if (timedOut) fs.writeFileSync(prefix + '_killed', '')
+      else if (code === 0 && !signal) fs.writeFileSync(prefix + '_finished', '')
+    }
+  }
+}
 
